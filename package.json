{
  "scripts": {
    "build": "pnpm run build:engine && pnpm run build:sheet-io && pnpm run build:app",
    "build:engine": "esbuild src/scheduler-engine.ts --bundle --format=cjs --platform=node --outfile=scheduler-engine.js && esbuild src/scheduler-engine.ts --bundle --format=iife --global-name=ShiftwiseEngine --platform=browser --outfile=dist/scheduler-engine.js",
    "build:sheet-io": "esbuild src/sheet-io.ts --bundle --format=cjs --platform=node --outfile=sheet-io.js && esbuild src/sheet-io.ts --bundle --format=iife --global-name=ShiftwiseSheetIO --platform=browser --outfile=dist/sheet-io.js",
    "sheet-template": "python3 scripts/make-sheet-template.py",
    "vendor": "node scripts/copy-vendor.js",
    "build:app": "esbuild src/app.ts --bundle --format=iife --platform=browser --outfile=dist/app.js",
    "build:wasm-embed": "node scripts/embed-highs-wasm.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && pnpm run build && node tests/wasm-embed.test.js && node tests/scheduler-engine.test.js && node tests/sheet-io.test.js && node tests/full-month.test.js && node tests/app-dom.test.js"
  },
  "dependencies": {
    "highs": "1.14.2",
    "javascript-lp-solver": "0.4.24",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "26.1.0",
    "typescript": "^7.0.2"
  }
}
